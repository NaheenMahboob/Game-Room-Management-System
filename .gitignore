# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local

# PWA / service worker build artifacts
/public/sw.js
/public/sw.js.map
/public/workbox-*.js
/public/workbox-*.js.map
/public/swe-worker-*.js
/public/swe-worker-*.js.map

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# member photo uploads (keep folder + placeholder)
/public/uploads/members/*
!/public/uploads/members/.gitkeep
!/public/uploads/members/placeholder.jpg

# private member photos (outside public/)
/storage/members/*
!/storage/members/.gitkeep
!/storage/members/placeholder.jpg

# Full backup bundles (SQL + photos + .env) — keep private; never commit
/backups/*
!/backups/.gitkeep
